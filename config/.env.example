# ===========================
# 資料夾路徑（文件匯入流程）
# ===========================
INGEST_INBOX_DIR=D:/AI_KB/inbox
INGEST_PROCESSING_DIR=D:/AI_KB/processing
INGEST_PROCESSED_DIR=D:/AI_KB/processed
INGEST_ERROR_DIR=D:/AI_KB/error

# ===========================
# PostgreSQL
# ===========================
POSTGRES_HOST=localhost
POSTGRES_PORT=65432
POSTGRES_DB=vectordb
POSTGRES_USER=testuser
POSTGRES_PASSWORD=testpwd

# ===========================
# Ollama
# ===========================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5
OLLAMA_EMBED_MODEL=bge-m3

# ===========================
# 文件匯入設定
# ===========================
EMBEDDING_API_URL=http://localhost:11434/api/embed
OCR_API_URL=
DEFAULT_DEPARTMENT=
DEFAULT_ACCESS_LEVEL=view

# ===========================
# API Server 公網存取設定
# ===========================
# ⚠️ 必須設為使用者手機可存取的公網 URL（例如 ngrok / 反向代理）
# 若設為 localhost，LINE Bot 傳送的檔案連結只有伺服器本機能打開！
# 範例：API_BASE_URL=https://abc123.ngrok.io
API_BASE_URL=http://localhost:8765

# 檔案存放目錄（/files/<name> 端點從此目錄讀取）
FILES_BASE_DIR=D:/職安

# ===========================
# LINE Messaging API
# ===========================
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ===========================
# 問答參數
# ===========================
QA_TOP_K=5
QA_MIN_SIMILARITY=0.7
DEFAULT_NO_ANSWER_MESSAGE=很抱歉，目前知識庫中找不到與您問題相關的資料，請聯繫相關部門或換個方式提問。
