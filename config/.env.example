# ============================================================
# AI 企業問答助理 — 環境變數範本
# 複製此檔案為 config/.env 並填入你的值
# 注意：.env 絕對不能 commit 到 Git！
# ============================================================

# LINE Messaging API
# 取得位置：https://developers.line.biz/ → Messaging API → Channel access token
LINE_CHANNEL_ACCESS_TOKEN=你的LINE_CHANNEL_ACCESS_TOKEN
LINE_CHANNEL_SECRET=你的LINE_CHANNEL_SECRET

# PostgreSQL（使用預設值即可，或自訂密碼）
POSTGRES_HOST=localhost
POSTGRES_PORT=65432
POSTGRES_DB=vectordb
POSTGRES_USER=testuser
POSTGRES_PASSWORD=testpwd

# Ollama（通常不需修改）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct-q4_0
OLLAMA_EMBED_MODEL=bge-m3

# 企業文件存放目錄（本地路徑，API Server 用於提供檔案下載）
FILES_BASE_DIR=D:/職安

# ngrok 靜態域名（填入你申請的 ngrok 域名）
NGROK_DOMAIN=你的域名.ngrok-free.dev
